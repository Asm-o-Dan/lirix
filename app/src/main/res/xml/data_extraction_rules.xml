<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+: cloud and direct device transfer have independent eligibility. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="event_engine.db" />
        <include domain="database" path="event_engine.db-wal" />
        <include domain="database" path="event_engine.db-shm" />
        <include domain="database" path="event_engine.db-journal" />
        <include domain="sharedpref" path="lirix_preferences.xml" />
        <include domain="sharedpref" path="lirix_translations.xml" />
        <include domain="sharedpref" path="lirix_ui_prompter_prefs.xml" />
        <include domain="sharedpref" path="lirix_sync_prefs.xml" />
        <include domain="sharedpref" path="media_sync_offsets.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="event_engine.db" />
        <include domain="database" path="event_engine.db-wal" />
        <include domain="database" path="event_engine.db-shm" />
        <include domain="database" path="event_engine.db-journal" />
        <include domain="sharedpref" path="lirix_preferences.xml" />
        <include domain="sharedpref" path="lirix_translations.xml" />
        <include domain="sharedpref" path="lirix_ui_prompter_prefs.xml" />
        <include domain="sharedpref" path="lirix_sync_prefs.xml" />
        <include domain="sharedpref" path="media_sync_offsets.xml" />
    </device-transfer>
</data-extraction-rules>
