{
  "sdd-subagent-guard": {
    "PreToolUse": [
      {
        "matcher": "invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/prevent_subagent.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/prevent_subagent.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/prevent_subagent.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

